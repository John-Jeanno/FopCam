# Configuration FopCam
# Copiez ce fichier vers .env et ajustez les valeurs

# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données
DATABASE_URL=sqlite:///db.sqlite3
# Pour PostgreSQL : postgresql://user:password@localhost:5432/fopcam

# Redis (pour Channels/WebSocket)
REDIS_URL=redis://localhost:6379/0

# API Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Live video (create a LiveKit Cloud project and configure these on the backend)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Paiements (optionnel - pour production)
WAVE_API_KEY=your-wave-api-key
ORANGE_CLIENT_ID=your-orange-client-id
ORANGE_CLIENT_SECRET=your-orange-client-secret

# Email (optionnel - pour notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# WhatsApp Cloud API (optional; use an approved template with one body parameter)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=fopcam_password_reset
WHATSAPP_TEMPLATE_LANGUAGE=fr
WHATSAPP_GRAPH_API_VERSION=v22.0

# Keep refresh sessions alive across long periods of use; logout revokes them.
JWT_REFRESH_TOKEN_LIFETIME_DAYS=3650