  static Future<bool> createPost(
    String content, {
    String privacy = 'public',
    String? location,
    List<String>? hashtags,
  }) async {
    try {
      final url = Uri.parse('${ApiEndpoints.baseUrl}${ApiEndpoints.posts}');
      final headers = await _getHeaders();
      final Map<String, dynamic> body = {
        'content': content,
        'privacy': privacy,
      };
      if (location != null) body['location'] = location;
      if (hashtags != null) body['hashtags'] = hashtags;

      var response = await http.post(
        url,
        headers: headers,
        body: jsonEncode(body),
      );

      if (await _refreshTokenIfNeeded(response)) {
        response = await http.post(
          url,
          headers: await _getHeaders(),
          body: jsonEncode(body),
        );
      }

      return response.statusCode == 201 || response.statusCode == 200;
    } catch (e) {
      debugPrint('Error creating post: $e');
      return false;
    }
  }

  static Future<bool> createPostWithImage(
    String content,
    String imagePath, {
    String privacy = 'public',
    String? location,
    List<String>? hashtags,
  }) async {
    try {
      final url = Uri.parse('${ApiEndpoints.baseUrl}${ApiEndpoints.posts}');
      final headers = await _getHeaders();
      headers.remove('Content-Type');
      final file = await http.MultipartFile.fromPath('image', imagePath);
      var request = http.MultipartRequest('POST', url)
        ..headers.addAll(headers)
        ..fields['content'] = content
        ..fields['privacy'] = privacy
        ..fields['post_type'] = 'image'
        ..files.add(file);

      if (location != null) request.fields['location'] = location;
      if (hashtags != null) request.fields['hashtags'] = jsonEncode(hashtags);

      var response = await request.send();
      return response.statusCode == 201 || response.statusCode == 200;
    } catch (e) {
      debugPrint('Error creating post with image: $e');
      return false;
    }
  }

  static Future<bool> createPostWithImages(
    String content,
    List<String> imagePaths, {
    String privacy = 'public',
    String? location,
    List<String>? hashtags,
  }) async {
    try {
      final url = Uri.parse('${ApiEndpoints.baseUrl}${ApiEndpoints.posts}');
      final headers = await _getHeaders();
      headers.remove('Content-Type');
      var request = http.MultipartRequest('POST', url)
        ..headers.addAll(headers)
        ..fields['content'] = content
        ..fields['privacy'] = privacy
        ..fields['post_type'] = 'album';

      for (final imagePath in imagePaths) {
        final file = await http.MultipartFile.fromPath('images', imagePath);
        request.files.add(file);
      }

      if (location != null) request.fields['location'] = location;
      if (hashtags != null) request.fields['hashtags'] = jsonEncode(hashtags);

      var response = await request.send();
      return response.statusCode == 201 || response.statusCode == 200;
    } catch (e) {
      debugPrint('Error creating post with images: $e');
      return false;
    }
  }

